    {
      "name": "Filter by Min Price 5000",
      "request": {
        "method": "GET",
        "url": "http://localhost:3000/api/hotels?city=delhi&minPrice=5000"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"All prices >= 5000\", function () {",
              "    var jsonData = pm.response.json();",
              "    jsonData.forEach(function(hotel) {",
              "        pm.expect(hotel.price).to.be.at.least(5000);",
              "    });",
              "});"
            ]
          }
        }
      ]
    },
