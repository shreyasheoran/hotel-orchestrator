{
  "info": {
    "name": "Hotel Offer Orchestrator",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "http://localhost:3000/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Service is healthy\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.service).to.eql(\"healthy\");",
              "});",
              "",
              "pm.test(\"Suppliers are up\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.supplierA).to.eql(\"up\");",
              "    pm.expect(jsonData.supplierB).to.eql(\"up\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get All Hotels (Delhi) — 1st call triggers workflow",
      "request": {
        "method": "GET",
        "url": "http://localhost:3000/api/hotels?city=delhi"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response is an array\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an('array');",
              "});",
              "",
              "pm.test(\"Hotels have required fields\", function () {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.length > 0) {",
              "        var hotel = jsonData[0];",
              "        pm.expect(hotel).to.have.property('name');",
              "        pm.expect(hotel).to.have.property('price');",
              "        pm.expect(hotel).to.have.property('supplier');",
              "        pm.expect(hotel).to.have.property('commissionPct');",
              "    }",
              "});"
            ]
          }
        }
      ]
    },
